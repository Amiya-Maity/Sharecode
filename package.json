{
  "name": "sharecoder",
  "displayName": "sharecoder",
  "description": "An extension to fetch and upload data from share.hackend.in",
  "version": "1.0.3",
  "publisher": "Amiya",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/vscode-extension-samples"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sharecoder.dnldselectcodes",
        "title": "Download from Sharecode(output: Copy to clipboard)"
      },
      {
        "command": "sharecoder.dnldfilecodes",
        "title": "Download from Sharecode(output: file)"
      },
      {
        "command": "sharecoder.upldselectcodes",
        "title": "Upload to Sharecode(input: selected text)"
      },
      {
        "command": "sharecoder.upldfilecodes",
        "title": "Upload to Sharecode(input: file)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sharecoder.dnldselectcodes",
          "group": "navigation",
          "title": "Download from Sharecode(output: Copy to clipboard)"
        },
        {
          "command": "sharecoder.dnldfilecodes",
          "group": "navigation",
          "title": "Download from Sharecode(output: file)"
        },
        {
          "command": "sharecoder.upldselectcodes",
          "group": "navigation",
          "title": "Upload to Sharecode(input: selected text)"
        },
        {
          "command": "sharecoder.upldfilecodes",
          "group": "navigation",
          "title": "Upload to Sharecode(input: file)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.26.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "vsce": "^1.97.0"
  }
}
